# Copy this file to `.env` and fill in real values.
# NEVER commit .env files — secrets must be supplied via Vercel/CI env vars.

# Public Supabase project URL (required for the app to enable its data layer).
REACT_APP_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon / publishable key. Safe for server-side use behind RLS.
# The service_role key must NEVER be used here or in the browser.
REACT_APP_SUPABASE_ANON_KEY=your-anon-key

# Optional: Google Maps JavaScript API key (client-side; restrict it in the
# Google Cloud console to your site's referrers).
# REACT_APP_GOOGLE_MAPS_API_KEY=